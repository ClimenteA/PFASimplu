# Copiaza acest fisier ca .env.prod pe VPS si completeaza valorile.
# NU se urca in git (e in .gitignore).

# Modul multi-user: login cu email + parola, date izolate per utilizator.
PFASIMPLU_MULTI_USER=1
PFASIMPLU_DEBUG=0

# Genereaza cu: python -c "import secrets; print(secrets.token_urlsafe(64))"
PFASIMPLU_SECRET_KEY=schimba-ma-cu-un-secret-aleator-lung

# Domeniul aplicatiei, separat prin virgula.
PFASIMPLU_ALLOWED_HOSTS=pfa.exemplu.ro
PFASIMPLU_CSRF_TRUSTED_ORIGINS=https://pfa.exemplu.ro

# Optional: blocheaza crearea de conturi noi (pagina de inregistrare devine 404;
# utilizatorii existenti se pot autentifica in continuare). Implicit 1.
# PFASIMPLU_ALLOW_REGISTRATION=0

# Optional: cont de admin creat la prima pornire (pentru /admin/).
# DJANGO_SUPERUSER_EMAIL=admin@exemplu.ro
# DJANGO_SUPERUSER_PASSWORD=o-parola-puternica
