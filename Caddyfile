# Schimba cu domeniul tau (DNS-ul trebuie sa pointeze spre VPS).
# Pentru test local fara domeniu: foloseste ":80" (fara TLS automat).
pfa.exemplu.ro {
	# Static files direct din Caddy (optional - whitenoise le serveste si el).
	handle_path /static/* {
		root * /webapp/staticfiles
		file_server
	}

	handle {
		reverse_proxy pfasimplu-app:8000
	}

	encode gzip zstd
}
