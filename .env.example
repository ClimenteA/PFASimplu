# Copiaza acest fisier ca .env (install.sh o face automat).
# Valorile sunt mock / de dezvoltare - nu contin secrete reale.
# Folosit de docker-compose-local.yaml atat pentru interpolarea porturilor,
# cat si ca env_file pentru containere.

PFASIMPLU_PORT=8990
PFASIMPLU_MCP_PORT=8997

# Genereaza alt sir daca vrei: python -c "import secrets; print(secrets.token_urlsafe(64))"
PFASIMPLU_SECRET_KEY=local-mock-secret-key-schimba-ma-daca-vrei-esti-in-regula

PFASIMPLU_DEBUG=0
# Pe HTTP (localhost) browserul nu trimite cookie-uri "Secure".
PFASIMPLU_SECURE_COOKIES=0
PFASIMPLU_ALLOWED_HOSTS=localhost,127.0.0.1
PFASIMPLU_CSRF_TRUSTED_ORIGINS=http://localhost:${PFASIMPLU_PORT:-8990},http://127.0.0.1:${PFASIMPLU_PORT:-8990}

# Optional: cont de admin creat la prima pornire (pentru /admin/).
# DJANGO_SUPERUSER_EMAIL=admin@exemplu.ro
# DJANGO_SUPERUSER_PASSWORD=o-parola-puternica

# Optional: 0 blocheaza inregistrarea de conturi noi.
# PFASIMPLU_ALLOW_REGISTRATION=0
